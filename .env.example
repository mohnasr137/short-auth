# ==============================================================================
# 🗄️ DATABASE CONFIGURATION (Required for Production / Developer Setup)
# ==============================================================================
# Database vendor: 'postgres' (recommended) or 'mysql' / 'mariadb'
DB_VENDOR=postgres

# JDBC Database Connection URL:
# 1. Local PostgreSQL running on host machine:
#    jdbc:postgresql://host.docker.internal:5432/my_database
# 2. Cloud Database (AWS RDS / Supabase / Neon):
#    jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
# 3. MySQL running on host machine:
#    jdbc:mysql://host.docker.internal:3306/my_database
DB_URL=jdbc:postgresql://host.docker.internal:5432/my_database

# Database credentials
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Database schema (keeps Keycloak tables isolated from your application tables)
DB_SCHEMA=keycloak

# ==============================================================================
# 🔐 AUTH MICROSERVICE & KEYCLOAK SETTINGS
# ==============================================================================
PORT=:3000
ENV=development

# Keycloak URLs
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/auth

# Keycloak OIDC Client
KEYCLOAK_REALM=auth
KEYCLOAK_CLIENT_ID=auth-backend
KEYCLOAK_CLIENT_SECRET=Dr4G0j6vvfWMdvrKdHAYBrDNdmopUgkEF0YRZuWrWRZOv7RWnJqJ26MseNiPrXjDQDo0ZCiOGbdcHvu2cWNuk8

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080
