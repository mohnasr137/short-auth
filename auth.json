          ],
          "query": [],
          "variable": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"mohamed\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.access_token) {",
              "    pm.collectionVariables.set(\"access_token\", data.access_token);",
              "    pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
              "    console.log(\"Tokens saved to collection variables successfully!\");",
              "}"
            ]
          }
        }
      ]
    },
